{
  "name": "primeoffice",
  "private": true,
  "version": "0.5.0",
  "description": "PrimeOffice — Pixel office for your AI coding agents",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/build-office-assets.mjs",
    "build": "node scripts/build-office-assets.mjs && tsc -b && vite build",
    "typecheck": "tsc -b",
    "guide": "node ../Abyss/scripts/user-guide.mjs",
    "tauri": "tauri",
    "release": "powershell -ExecutionPolicy Bypass -File \"../Abyss/scripts/release.ps1\" -App .",
    "check:mock": "node scripts/check-mock.mjs",
    "test:ts": "node --test scripts/tests/departments.test.ts scripts/tests/chatEvents.test.ts scripts/tests/briefing.test.ts scripts/tests/rooms.test.ts",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run check:mock && npm run test:ts && npm run test"
  },
  "dependencies": {
    "@abyss/ui": "file:../Abyss/packages/abyss-ui",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@material-symbols/font-700": "^0.46.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
