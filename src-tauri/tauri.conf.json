{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PrimeOffice",
  "version": "0.7.0",
  "identifier": "com.phineas.primeoffice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1484",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PrimeOffice",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "frame-src": "'self'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "worker-src": "'self' blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Pixel office for your AI coding agents",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "PrimeOffice",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Phineas",
    "copyright": "© 2026 Hoàng Trọng Phi",
    "homepage": "https://github.com/HoangTrongPhi/PrimeOffice",
    "resources": {
      "../docs/user-guide/PrimeOffice_User_Guide_vi.pdf": "user-guide/PrimeOffice_User_Guide_vi.pdf",
      "../docs/user-guide/PrimeOffice_User_Guide_en.pdf": "user-guide/PrimeOffice_User_Guide_en.pdf",
      "../skill-library/HUONG_DAN.md": "skill-library/HUONG_DAN.md",
      "../skill-library/README.md": "skill-library/README.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4NThCNTBGOEU4QkI0RTEKUldUaHRJdU9EN1ZZcU5ZK3FmNjQvdHNGbVJsUExRVk1PdU1LRDgvbW9NbWNiNms2TzlxSGtWRzUK",
      "endpoints": [
        "https://github.com/HoangTrongPhi/PrimeOffice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
